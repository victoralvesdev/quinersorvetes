# =============================================================================
# VARIÁVEIS DE AMBIENTE — QuinerApp
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA commite o .env.local no git.
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Admin (server-side only — NÃO usar prefixo NEXT_PUBLIC_)
ADMIN_PASSWORD=sua_senha_admin_forte_aqui

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token_here
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key_here
# Obtenha em: Mercado Pago → Integrações → Webhooks → Chave secreta
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret_here

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://your-evolution-api-url.com
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE=Quiner

# WhatsApp do Administrador (com DDI, ex: 5511999999999)
ADMIN_WHATSAPP_NUMBER=55119xxxxxxxx

# Google Maps Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Cron Jobs (protege a rota /api/whatsapp/delivery-reminder)
CRON_SECRET=your_cron_secret_here

# Preview Access (acesso antecipado ao site)
PREVIEW_ACCESS_PHONE=11999999999
